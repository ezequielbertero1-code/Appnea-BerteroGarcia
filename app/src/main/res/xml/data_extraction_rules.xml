<?xml version="1.0" encoding="utf-8"?>
<!--
    Qué se respalda en Android 12+ (copia en la nube y pasar a un teléfono nuevo).
    Solo la base de datos: inmersiones, entrenamientos, perfil, equipo, etc.
    NO se respaldan las SharedPreferences:
      - sesion.xml: al restaurar en otro teléfono hay que volver a iniciar sesión;
      - login.xml: los intentos fallidos y el bloqueo son de este teléfono;
      - seed.xml (solo debug): marca de los datos de ejemplo.
    Con <include>, todo lo que no está incluido queda afuera (también cachés como la del mapa).
    Ver https://developer.android.com/identity/data/autobackup
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
